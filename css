
*{
    margin:0;
}

/*---------- FIRST PAGE ---------- */

.Main1{
    width:100vw;
    height:100vh;
    position:relative;
}

#main1_image{
    width:100%;
    height:100%;
}

.sub11{
    position:absolute;
    right:50px;
    top:50px;
}

.sub11 img{
    width:200px;
}

.sub12{
    position:absolute;
    top:10px;
    left:50px;
}

.sub12 img{
    width:200px;
}

.sub13{
    font-size:20px;
    position:absolute;
    top:200px;
    left:50px;
    color:silver;
}

.sub13 td{
    padding-bottom:20px;
    transition:0.5s;
}

.sub13 td:hover{
    padding-left:30px;
    color:red;
}

.sub14{
    transition:0.5s;
    font-size:50px;
    text-align:center;
    position:absolute;
    bottom:5vh;
    width:80vw;
    left:10vw;
    color:silver;
    opacity:0.8;
}

.Main1:hover .sub14{
    font-size:60px;
    opacity:1;
}

span{
    color:red;
}

/* ---------- SECOND PAGE ---------- */

.Main2{
    width:100vw;
    height:100vh;
    background:black;
    position:relative;
}

.sub21{
    width:40vw;
    height:40vh;
    position:absolute;
    left:5vw;
    top:30vh;
    font-size:15px;
    color:white;
    text-align:center;
}

.sub22{
    width:50vw;
    height:100vh;
    position:absolute;
    left:50vw;
    transition:2s;

}

.sub22 img{
    width:100vw;
    height:100vh;
}
.sub23 {
    width: 100vw;
    height: 100vh;
    position: absolute;
    left: -100vw;
    transition:3s;
}
.sub23 img{
    width:100vw;
    height:100vh;
}

/*.. SLIDE TRANSITION.. */
.Main2:hover .sub22{
    left:0;
}

.Main2:hover .sub23{
    left: 0vh;
    transition-delay: 3s;
}
